# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 저장소에 올리지 않습니다.
# 운영 서버에서는 파일 대신 호스팅 서비스의 "환경 변수 / 시크릿" 메뉴에 같은 이름으로 넣으세요.

# --- 실행 환경 ---------------------------------------------------------------
# 운영에서는 production. (console 문자, http 주소를 거부합니다)
# PUBLIC_ORIGIN 이 localhost 가 아니면 이 값과 상관없이 운영 기준이 적용됩니다.
NODE_ENV=
PORT=8080
# 브라우저에서 접속하는 주소. 경로 없이 정확히 적습니다. 운영은 https 만 가능.
PUBLIC_ORIGIN=http://localhost:8080
# HTTPS 를 처리하는 프록시(호스팅 서비스의 로드밸런서 등) 뒤에 있으면 그 단계 수. 직접 받으면 0.
TRUST_PROXY=0
# 프록시 없이 이 서버가 직접 HTTPS 를 받을 때만 지정
TLS_CERT_FILE=
TLS_KEY_FILE=

# --- 사용자 2명 --------------------------------------------------------------
# 비밀번호 해시는 `npm run hash-password` 로 만듭니다. 비밀번호 원문은 어디에도 적지 않습니다.
USER1_ID=
USER1_NAME=
USER1_PHONE=
USER1_PASSWORD_HASH=

USER2_ID=
USER2_NAME=
USER2_PHONE=
USER2_PASSWORD_HASH=

# 처음에 조작 권한을 갖는 사람의 아이디 (비우면 USER1)
INITIAL_CONTROLLER=

# --- 문자 발송 ---------------------------------------------------------------
# console(개발용: 서버 로그에 인증번호 출력) | solapi | sens | twilio
SMS_PROVIDER=console
# 발신 번호 (발송 서비스에 등록된 번호)
SMS_FROM=

# solapi
SOLAPI_API_KEY=
SOLAPI_API_SECRET=

# sens (네이버 클라우드)
SENS_ACCESS_KEY=
SENS_SECRET_KEY=
SENS_SERVICE_ID=

# twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Guacamole ---------------------------------------------------------------
# 아래에 미리 적힌 값은 연습용 가짜 Guacamole(`npm run mock`)에 맞춘 것입니다. 운영에서는 실제 값으로 바꾸세요.
# Guacamole 웹 주소 (로그인 화면이 뜨는 주소, 끝의 /#/ 는 빼고). 운영은 https 만 가능.
GUAC_URL=http://127.0.0.1:8081/guacamole
# 이 게이트 전용 Guacamole 계정. 접근제어 PC 연결 하나에 대한 "읽기" 권한만 줍니다.
GUAC_USERNAME=gate-service
GUAC_PASSWORD=mock-password
# 연결 번호 (README 의 "연결 번호 찾기" 참고)
GUAC_CONNECTION_ID=1
# 비우면 Guacamole 이 알려 주는 기본값을 씁니다 (예: postgresql, mysql)
GUAC_DATA_SOURCE=
# Guacamole 앞단이 추가 헤더를 요구할 때 (예: Cloudflare Access 서비스 토큰)
# GUAC_EXTRA_HEADERS={"CF-Access-Client-Id":"...","CF-Access-Client-Secret":"..."}
GUAC_EXTRA_HEADERS=

# --- 원격 화면 ---------------------------------------------------------------
REMOTE_WIDTH=1600
REMOTE_HEIGHT=900
REMOTE_DPI=96

# --- 시간 제한 ---------------------------------------------------------------
# 인증번호 유효 시간(초)
OTP_TTL_SECONDS=180
# 화면을 닫거나 연결이 끊긴 뒤 세션이 끝나기까지(초)
SESSION_IDLE_SECONDS=120
# 인증 후 최대 사용 시간(분). 지나면 다시 인증해야 합니다.
SESSION_MAX_MINUTES=120
